{
  "rules": {
    "sessions": {
      "$sid": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid",
        ".validate": "newData.hasChildren(['name', 'createdAt'])",

        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "owner": { ".validate": "newData.isString()" },
        "config": {
          "mode": { ".validate": "newData.val() === 'single' || newData.val() === 'mixed'" },
          "drinks": {
            "$i": { ".validate": "newData.isString() && newData.val().length <= 20" }
          },
          "beerSize": { ".validate": "newData.val() === 0.2 || newData.val() === 0.3 || newData.val() === 0.5" },
          "$other": { ".validate": false }
        },

        "players": {
          "$name": {
            ".write": "auth != null && newData.exists() && $name.length <= 20 && newData.child('uid').val() === auth.uid && (!data.child('uid').exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChild('joinedAt')",

            "uid": {
              ".write": "auth != null && !newData.exists() && root.child('sessions/' + $sid + '/owner').val() === auth.uid",
              ".validate": "newData.isString()"
            },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "count": { ".validate": "newData.isNumber()" },
            "cigs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
            "drinks": {
              "$drink": { ".validate": "$drink.length <= 20 && newData.isNumber() && newData.val() > -1000 && newData.val() < 1000" }
            },
            "status": {
              "type": { ".validate": "newData.val() === 'toilet' || newData.val() === 'smoke'" },
              "since": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "events": {
          ".indexOn": ["player", "ts"],
          "$eid": {
            ".write": "auth != null && (newData.exists() ? root.child('sessions/' + $sid + '/players/' + newData.child('player').val() + '/uid').val() === auth.uid : root.child('sessions/' + $sid + '/players/' + data.child('player').val() + '/uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['type', 'player', 'ts'])",

            "type": { ".validate": "newData.val() === 'drink' || newData.val() === 'cig' || newData.val() === 'toilet' || newData.val() === 'smoke'" },
            "player": { ".validate": "newData.isString()" },
            "drink": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "ts": { ".validate": "newData.isNumber()" },
            "end": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "games": {
          "$gid": {
            ".write": "auth != null && !data.exists() && newData.child('status').val() === 'lobby' && root.child('sessions/' + $sid + '/players/' + newData.child('host').val() + '/uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'host', 'status', 'createdAt'])",

            "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "host": { ".validate": "newData.isString()" },
            "createdAt": { ".validate": "newData.isNumber()" },

            "status": {
              ".write": "auth != null && data.exists() && ((root.child('sessions/' + $sid + '/players/' + data.parent().child('host').val() + '/uid').val() === auth.uid && ((data.val() === 'lobby' && newData.val() === 'running') || ((data.val() === 'lobby' || data.val() === 'running') && newData.val() === 'aborted'))) || (data.val() === 'running' && newData.val() === 'finished' && data.parent().child('order').hasChild(newData.parent().child('endedBy').val() + '') && root.child('sessions/' + $sid + '/players/' + newData.parent().child('endedBy').val() + '/uid').val() === auth.uid))",
              ".validate": "newData.val() === 'lobby' || newData.val() === 'running' || newData.val() === 'finished' || newData.val() === 'aborted'"
            },
            "startedAt": {
              ".write": "auth != null && !data.exists() && newData.parent().child('status').val() === 'running'",
              ".validate": "newData.isNumber()"
            },
            "seed": {
              ".write": "auth != null && !data.exists() && newData.parent().child('status').val() === 'running'",
              ".validate": "newData.isNumber()"
            },
            "order": {
              ".write": "auth != null && !data.exists() && newData.parent().child('status').val() === 'running' && root.child('sessions/' + $sid + '/players/' + data.parent().child('host').val() + '/uid').val() === auth.uid",
              "$p": { ".validate": "newData.isNumber() && newData.parent().parent().child('players').hasChild($p)" }
            },
            "endedAt": {
              ".write": "auth != null && !data.exists() && newData.parent().child('status').val() === 'finished'",
              ".validate": "newData.isNumber()"
            },
            "endedBy": {
              ".write": "auth != null && !data.exists() && newData.parent().child('status').val() === 'finished'",
              ".validate": "newData.isString()"
            },

            "players": {
              "$p": {
                ".write": "auth != null && data.parent().parent().child('status').val() === 'lobby' && $p !== data.parent().parent().child('host').val() && root.child('sessions/' + $sid + '/players/' + $p + '/uid').val() === auth.uid",
                ".validate": "newData.child('joinedAt').isNumber() && root.child('sessions/' + $sid + '/players/' + $p + '/uid').val() === auth.uid",
                "joinedAt": { ".validate": true },
                "$other": { ".validate": false }
              }
            },

            "moves": {
              "$mid": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('sessions/' + $sid + '/games/' + $gid + '/status').val() === 'running' && root.child('sessions/' + $sid + '/games/' + $gid + '/order').hasChild(newData.child('player').val() + '') && root.child('sessions/' + $sid + '/players/' + newData.child('player').val() + '/uid').val() === auth.uid",
                ".validate": "newData.hasChildren(['player', 'type', 'ts'])",
                "player": { ".validate": "newData.isString()" },
                "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
                "ts": { ".validate": "newData.isNumber()" },
                "data": { ".validate": true },
                "$other": { ".validate": false }
              }
            },

            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
